# Copy to `.env` and fill in. Never commit `.env`.
X_AUTH_TOKEN=
X_CT0=
# Optional YouTube login cookie (raw Cookie header for youtube.com).
# Enables age-restricted videos for yt search/info/transcript + frames.
# Leave empty for anonymous access.
YT_COOKIE=
REDLIB_URL=http://127.0.0.1:8182
# Optional explicit redlib binary path (default: PATH, then ~/.local/bin/redlib).
REDLIB_BIN=
